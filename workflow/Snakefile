default_config = {
    'log_level': 'info',
    'seed': 123,
}

config = {**default_config, **config}

include: "rules/benchmarks.smk"
include: "rules/data.smk"
include: "rules/models.smk"
include: "rules/notebooks.smk"
include: "rules/visualisations.smk"

rule environment:
    shell:
        """
        git submodule init
        mamba env create -f environment.yml
        mamba run -n tcr-antigen-prediction python -m pip install .
        mamba run -n tcr-antigen-prediction stitchrdl -s human
        mamba run -n tcr-antigen-prediction stitchrdl -s mouse
        git submodule update --remote third_party/anarci
        site_packages=$(mamba run -n tcr-antigen-prediction python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')
        cp -r third_party/anarci "$site_packages/"
        git submodule update --remote third_party/NetTCR
        mamba run -n tcr-antigen-prediction pip install third_party/NetTCR
        """

rule lint:
    shell:
        """
        ruff check
        ruff format --check
        """

rule test:
    shell: "pytest --cov=src tests"

rule docs:
    shell:
        """
        sphinx-apidoc -f -e -o docs/source src/tcr_antigen_prediction $(find src -name *.py -path "src/**/apps/*")
        python docs/document_clis.py docs/source
        python docs/document_notebooks.py notebooks docs/source
        sphinx-build -b html ./docs ./docs/public
        """
